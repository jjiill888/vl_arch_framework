{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "vl_arch",
  "version": "0.1.0",
  "identifier": "com.vl-arch.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://server.15110y.top:8083",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "url": "http://server.15110y.top:8083",
        "title": "vl_arch",
        "width": 1200,
        "height": 800,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
